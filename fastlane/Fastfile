require "base64"
require "fileutils"
require "json"
require "open3"
require "shellwords"

module BlindBuilder
  # TestFlight rejects "What to Test" beyond 4000 characters, so the generated
  # changelog is clamped with room to spare for the truncation notice.
  CHANGELOG_LIMIT = 3800
  CHANGELOG_MAX_ENTRIES = 100
  CHANGELOG_FALLBACK_DEPTH = 10

  module_function

  def ci_metadata(config)
    metadata = config["ci"]
    metadata.is_a?(Hash) ? metadata : {}
  end

  def pull_request?(config)
    ci_metadata(config)["kind"].to_s == "pull_request"
  end

  def pull_request_number(config)
    number = ci_metadata(config)["pull_request"].to_i
    raise "Build configuration could not be loaded." unless number.positive?

    number
  end

  def load_config(options)
    path = options[:config] || options["config"] || ENV.fetch("IOS_CI_CONFIG")
    JSON.parse(File.read(path))
  rescue KeyError, Errno::ENOENT, JSON::ParserError
    raise "Build configuration could not be loaded."
  end

  def source_root
    ENV.fetch("IOS_CI_SOURCE")
  end

  def output_root
    ENV.fetch("IOS_CI_OUTPUT")
  end

  def derived_data_root
    ENV.fetch("IOS_CI_DERIVED_DATA")
  end

  # Swift package checkouts sit beside derived data rather than inside it, so they survive a
  # clean build: a job that insists on compiling from scratch still skips re-cloning and
  # re-resolving every dependency. Empty when the worker could not claim a cache directory,
  # in which case xcodebuild keeps the checkouts in derived data as it did before.
  def cloned_source_packages_root
    root = ENV.fetch("IOS_CI_CLONED_SOURCE_PACKAGES", "").to_s
    root.empty? ? nil : root
  end

  def incremental_build?
    ENV.fetch("IOS_CI_INCREMENTAL", "").to_s == "1"
  end

  # Carrying derived data between builds only buys anything if the build is allowed to reuse
  # what is in it, so cleaning is off wherever the cache is live and on wherever it is not --
  # an uncached directory is empty anyway. A job that wants the guarantees of a from-scratch
  # build sets build.clean and gives the reuse up.
  def clean_build?(config)
    configured = config.fetch("build", {})["clean"]
    return configured == true unless configured.nil?

    !incremental_build?
  end

  def project_settings(config, target)
    project = config.fetch("project")
    path = target["path"] || project.fetch("path")
    kind = target.fetch("kind", project.fetch("kind", path.end_with?(".xcworkspace") ? "workspace" : "project"))
    raise "Build configuration could not be loaded." unless %w[project workspace].include?(kind)

    [kind, File.join(source_root, path)]
  end

  def build_configuration(config, target)
    target.fetch("configuration", config.fetch("build", {}).fetch("configuration", "Release"))
  end

  def target_platform(target)
    platform = target.fetch("platform", target.fetch("sdk", "iphoneos") == "appletvos" ? "appletvos" : "ios")
    raise "Build configuration could not be loaded." unless %w[ios appletvos].include?(platform)

    platform
  end

  def signing_platform(target)
    target_platform(target) == "appletvos" ? "tvos" : "ios"
  end

  def target_bundle_ids(target)
    bundle_ids = Array(target.fetch("bundle_ids")).map(&:to_s).reject(&:empty?)
    raise "Build configuration could not be loaded." if bundle_ids.empty?

    bundle_ids
  end

  def api_key_options
    private_key = ENV.fetch("ASC_PRIVATE_KEY")
    private_key = Base64.strict_decode64(private_key) if ENV.fetch("ASC_PRIVATE_KEY_BASE64", "").casecmp?("true")

    {
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: private_key,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    }
  end

  def xcode_setting(config, target, key)
    kind, path = project_settings(config, target)
    command = ["xcodebuild", kind == "workspace" ? "-workspace" : "-project", path,
               "-scheme", target.fetch("scheme"),
               "-configuration", build_configuration(config, target),
               "-showBuildSettings"]
    output, status = Open3.capture2e(*command, chdir: source_root)
    raise "Build configuration could not be loaded." unless status.success?

    output.each_line do |line|
      match = line.match(/^\s*#{Regexp.escape(key)}\s*=\s*(.*?)\s*$/)
      return match[1] if match
    end

    nil
  end

  def marketing_version(config, target)
    version = target["version"] || config.fetch("build", {})["marketing_version"]
    version ||= xcode_setting(config, target, "MARKETING_VERSION")
    raise "Build configuration could not be loaded." if version.to_s.empty?

    version.to_s
  end

  # Every build takes the next whole number above the newest TestFlight build, so the
  # leading component always increases. Pull request builds append the pull request
  # number, which keeps them unique, ordered above the release train they branched from,
  # and recognisable at a glance in the TestFlight build list: 42 versus 42.17.
  def build_number(config, latest)
    next_number = latest.to_i + 1
    return next_number.to_s unless pull_request?(config)

    "#{next_number}.#{pull_request_number(config)}"
  end

  def latest_build_number_options(config, target, api_key)
    {
      api_key: api_key,
      app_identifier: target.fetch("app_identifier", target_bundle_ids(target).first),
      version: marketing_version(config, target),
      platform: target_platform(target),
      initial_build_number: 0
    }
  end

  def signing_options(config, target, api_key)
    signing = config.fetch("signing")
    {
      type: signing.fetch("type", "appstore"),
      readonly: true,
      git_url: signing.fetch("git_url"),
      git_branch: signing.fetch("branch", "main"),
      app_identifier: target_bundle_ids(target),
      platform: signing_platform(target),
      api_key: api_key,
      clone_branch_directly: true
    }
  end

  def git_capture(*arguments)
    output, status = Open3.capture2("git", "-C", source_root, *arguments)
    status.success? ? output : nil
  end

  # The worker fetches only the commit under build, then deepens the history far enough to
  # reach the reference point recorded for this source: the previously published commit for a
  # branch build, the base branch head for a pull request. The merge base of that reference and
  # HEAD is where this build's commits start. Anything unresolvable falls back to recent history.
  def changelog_base(config)
    previous = ci_metadata(config)["previous_sha"].to_s
    return nil if previous.empty?

    base = git_capture("merge-base", previous, "HEAD").to_s.strip
    return nil if base.empty?

    base == git_capture("rev-parse", "HEAD").to_s.strip ? nil : base
  end

  def changelog_entries(config)
    base = changelog_base(config)
    arguments = ["log", "--no-merges", "--pretty=format:%s (%h)"]
    arguments += base ? ["#{base}..HEAD"] : ["-#{CHANGELOG_FALLBACK_DEPTH}"]

    output = git_capture(*arguments)
    raise "Build configuration could not be loaded." if output.nil?

    entries = output.lines.map(&:strip).reject(&:empty?).uniq
    entries = git_capture("log", "-1", "--pretty=format:%s (%h)").to_s.lines.map(&:strip).reject(&:empty?) if entries.empty?
    raise "Build configuration could not be loaded." if entries.empty?

    entries
  end

  def changelog_heading(config)
    return [] unless pull_request?(config)

    heading = "Pull request ##{pull_request_number(config)}"
    title = ci_metadata(config)["title"].to_s.strip
    heading = "#{heading} — #{title}" unless title.empty?
    [heading, ""]
  end

  def clamp_changelog(lines)
    changelog = lines.join("\n")
    return changelog if changelog.length <= CHANGELOG_LIMIT

    notice = "…changelog truncated"
    budget = CHANGELOG_LIMIT - notice.length - 1
    kept = []
    length = 0
    lines.each do |line|
      break if length + line.length + 1 > budget

      kept << line
      length += line.length + 1
    end
    (kept << notice).join("\n")
  end

  def generated_changelog(config)
    configured = config.fetch("testflight", {})["changelog"]
    return configured.to_s unless configured.to_s.empty?

    entries = changelog_entries(config)
    omitted = entries.length - CHANGELOG_MAX_ENTRIES
    entries = entries.first(CHANGELOG_MAX_ENTRIES)

    lines = changelog_heading(config)
    lines += entries.map { |entry| "• #{entry}" }
    lines << "…and #{omitted} more commits" if omitted.positive?
    clamp_changelog(lines)
  end

  # Pull request builds are verification builds: they reach internal testers as soon as
  # processing finishes, without an Apple beta review round or mail to external groups.
  def testflight_settings(config)
    settings = config.fetch("testflight", {})
    return settings unless pull_request?(config)

    settings.merge(
      "groups" => [],
      "distribute_external" => false,
      "notify_external_testers" => false,
      "submit_beta_review" => false
    )
  end

  def upload_options(config, target, api_key, ipa_path)
    testflight = testflight_settings(config)
    groups = pull_request?(config) ? [] : (target["testflight_groups"] || testflight["groups"] || [])
    groups = Array(groups).map(&:to_s).reject(&:empty?)
    distribute_external = testflight.fetch("distribute_external", true)
    skip_waiting = testflight.fetch("skip_waiting_for_build_processing", false)

    raise "Build configuration could not be loaded." if distribute_external && groups.empty?
    raise "Build configuration could not be loaded." if distribute_external && skip_waiting

    options = {
      api_key: api_key,
      ipa: ipa_path,
      app_identifier: target.fetch("app_identifier", target_bundle_ids(target).first),
      app_platform: target_platform(target),
      distribute_external: distribute_external,
      notify_external_testers: testflight.fetch("notify_external_testers", true),
      submit_beta_review: testflight.fetch("submit_beta_review", true),
      skip_waiting_for_build_processing: skip_waiting,
      uses_non_exempt_encryption: testflight.fetch("uses_non_exempt_encryption", false),
      changelog: target["changelog"] || generated_changelog(config),
      wait_processing_interval: testflight.fetch("wait_processing_interval", 30),
      wait_processing_timeout_duration: testflight.fetch("wait_processing_timeout_duration", 3600)
    }

    options[:groups] = groups unless groups.empty?
    %w[beta_app_review_info localized_app_info localized_build_info].each do |key|
      value = target[key] || testflight[key]
      options[key.to_sym] = value if value
    end
    options
  end

  def build_options(config, target, index, build_number)
    kind, path = project_settings(config, target)
    slot = format("target-%02d", index + 1)
    target_output = File.join(output_root, slot)
    target_derived_data = File.join(derived_data_root, slot)
    FileUtils.mkdir_p(target_output)
    FileUtils.mkdir_p(target_derived_data)

    xcode_version, status = Open3.capture2("xcodebuild", "-version")
    raise "Build configuration could not be loaded." unless status.success?

    xcargs = ["CURRENT_PROJECT_VERSION=#{build_number}"]
    configured_xcargs = config.fetch("build", {})["xcargs"]
    case configured_xcargs
    when Hash
      configured_xcargs.each do |key, value|
        setting = key.to_s
        raise "Build configuration could not be loaded." unless setting.match?(/\A[A-Za-z_][A-Za-z0-9_]*\z/)

        xcargs << "#{setting}=#{Shellwords.escape(value.to_s)}"
      end
    when String
      xcargs << configured_xcargs unless configured_xcargs.empty?
    end
    xcargs << "SWIFT_ACTIVE_COMPILATION_CONDITIONS='$(inherited) XCODE27_SDK'" if xcode_version.lines.first.to_s.start_with?("Xcode 27.")

    options = {
      scheme: target.fetch("scheme"),
      configuration: build_configuration(config, target),
      sdk: target.fetch("sdk"),
      export_method: target.fetch("export_method", "app-store"),
      output_directory: target_output,
      output_name: "build",
      derived_data_path: target_derived_data,
      clean: clean_build?(config),
      destination: target_platform(target) == "appletvos" ? "generic/platform=tvOS" : "generic/platform=iOS",
      xcargs: xcargs.join(" ")
    }
    options[kind.to_sym] = path

    packages_root = cloned_source_packages_root
    if packages_root
      target_packages = File.join(packages_root, slot)
      FileUtils.mkdir_p(target_packages)
      options[:cloned_source_packages_path] = target_packages
    end

    options
  end

  def target_ipa_path(index)
    File.join(output_root, format("target-%02d", index + 1), "build.ipa")
  end

  def provision_options(options)
    bundle_ids = options[:bundle_ids].to_s.split(",").map(&:strip).reject(&:empty?)
    platform = options[:platform].to_s
    type = options[:type].to_s
    git_url = options[:git_url].to_s
    git_branch = options[:git_branch].to_s

    raise "Provision failed." if bundle_ids.empty?
    raise "Provision failed." unless %w[ios tvos].include?(platform)
    raise "Provision failed." unless %w[appstore adhoc development].include?(type)
    raise "Provision failed." unless git_url.match?(%r{\Ahttps://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\.git\z})
    raise "Provision failed." if git_branch.empty?

    {
      type: type,
      readonly: false,
      git_url: git_url,
      git_branch: git_branch,
      app_identifier: bundle_ids,
      platform: platform,
      clone_branch_directly: true
    }
  end
end

default_platform(:ios)

platform :ios do
  lane :ci_build do |options|
    config = BlindBuilder.load_config(options)
    api_key = app_store_connect_api_key(BlindBuilder.api_key_options)
    targets = config.fetch("project").fetch("targets")

    setup_ci
    targets.each_with_index do |target, index|
      Dir.chdir(BlindBuilder.source_root) do
        latest = latest_testflight_build_number(BlindBuilder.latest_build_number_options(config, target, api_key))
        match(BlindBuilder.signing_options(config, target, api_key))
        build_app(BlindBuilder.build_options(config, target, index, BlindBuilder.build_number(config, latest)))
      end
    end
  end

  lane :ci_publish do |options|
    config = BlindBuilder.load_config(options)
    api_key = app_store_connect_api_key(BlindBuilder.api_key_options)
    targets = config.fetch("project").fetch("targets")

    targets.each_with_index do |target, index|
      ipa_path = BlindBuilder.target_ipa_path(index)
      raise "Publish failed." unless File.file?(ipa_path)

      begin
        upload_to_testflight(BlindBuilder.upload_options(config, target, api_key, ipa_path))
      rescue StandardError => error
        raise unless error.message.include?("Another build is in review")

        UI.important("An existing build is already in beta review; the uploaded build remains available for the configured testers.")
      end
    end
  end

  # One-off onboarding for a new app: creates the certificate and profile that
  # ci_build later consumes read-only, and commits them to the signing repository.
  # The bundle identifier must already exist in the Developer Portal.
  lane :ci_provision do |options|
    api_key = app_store_connect_api_key(BlindBuilder.api_key_options)

    setup_ci
    match(BlindBuilder.provision_options(options).merge(api_key: api_key))
  end
end
